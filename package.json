{
  "name": "koe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small multi-product feedback service on Cloudflare Workers and D1.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit && tsc --noEmit -p test && wrangler deploy --dry-run",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.19.0",
    "miniflare": "5.20260926.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": "$miniflare",
      "wrangler": "$wrangler"
    }
  }
}
