{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One environment: production. The service is small and rarely changes, so there
  // is no separate test deployment; `npm run dev` runs locally against a local D1.
  "name": "koe",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [{ "pattern": "koe.44san.com", "custom_domain": true }],
  // Non-secret runtime parameters. TURNSTILE_SITE_KEY is public by design; while
  // empty the feedback page answers 503 (.dev.vars overrides it with Cloudflare's
  // testing key locally). MAIL_FROM must be an address on a domain with Email Routing.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYRXdO-syJF90ED",
    "MAIL_FROM": "koe@44san.com"
  },
  // Names only, so type generation works without .dev.vars. Values come from
  // .dev.vars locally and `wrangler secret put` when deployed.
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "ADMIN_TOKEN"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "koe", "database_id": "9d080c1d-b796-4b31-874e-5860b8d94f9b", "migrations_dir": "migrations" }
  ],
  // Free on any plan when sending to verified destination addresses.
  "send_email": [{ "name": "EMAIL" }]
}
