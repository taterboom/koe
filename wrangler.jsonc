{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level is the TEST environment: `npm run dev` and a bare `wrangler deploy`
  // can never touch production. Production is `--env production`. Named
  // environments inherit none of vars / secrets / bindings / routes, so
  // production restates each of them.
  "name": "koe-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [{ "pattern": "koe-test.44san.com", "custom_domain": true }],
  // Non-secret runtime parameters. TURNSTILE_SITE_KEY is public by design (one
  // widget serves both hostnames); while empty the feedback page answers 503.
  // MAIL_FROM must be an address on a domain with Email Routing.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYRXdO-syJF90ED",
    "MAIL_FROM": "koe@44san.com"
  },
  // Names only, so type generation works without .dev.vars. Values come from
  // .dev.vars locally and `wrangler secret put [--env production]` when deployed.
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "ADMIN_TOKEN"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "koe-test", "database_id": "cfee591a-b9d1-4089-b712-cca7182fda18", "migrations_dir": "migrations" }
  ],
  // Free on any plan when sending to verified destination addresses.
  "send_email": [{ "name": "EMAIL" }],
  "env": {
    "production": {
      "name": "koe",
      "routes": [{ "pattern": "koe.44san.com", "custom_domain": true }],
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFYRXdO-syJF90ED",
        "MAIL_FROM": "koe@44san.com"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY", "ADMIN_TOKEN"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "koe", "database_id": "9d080c1d-b796-4b31-874e-5860b8d94f9b", "migrations_dir": "migrations" }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
